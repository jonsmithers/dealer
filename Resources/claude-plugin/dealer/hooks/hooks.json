{
  "description": "Dealer (#12): waiting on permission / MCP input / API errors, done at the end of a turn. See docs/claude-code-states.md.",
  "hooks": {
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dealer-hook.sh\" permission", "timeout": 5 }] }
    ],
    "Notification": [
      { "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dealer-hook.sh\" notification", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dealer-hook.sh\" stop", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dealer-hook.sh\" stop-failure", "timeout": 5 }] }
    ]
  }
}
