+    /// Dealer: OSC 7501. Answer the support query here, on the read thread, so the
+    /// reply is queued before the reply to a following `CSI c`. Pass reports, already
+    /// validated by the parser, to the apprt as their raw body.
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) !void {
+        switch (cmd) {
+            .query => |t| switch (t) {
+                inline else => |tt| self.messageWriter(.{ .write_stable = "\x1b]7501;" ++
+                    terminal.osc.program_status.query_reply ++ comptime tt.string() }),
+            },
+            .report => |r| self.surfaceMessageWriter(.{
+                .program_status = try apprt.surface.Message.WriteReq.init(self.alloc, r.data),
+            }),
+        }
+    }
+
