+/// Dealer: an OSC 7501 report body, everything after `7501;`, already validated by
+/// terminal.osc.program_status (limits, base64, control characters, ids). Only valid
+/// for the duration of the action callback. A full reset (RIS) sends an empty body.
+pub const ProgramStatus = struct {
+    data: []const u8,
+
+    // Sync with: ghostty_action_program_status_s
+    pub const C = extern struct {
+        data: [*]const u8,
+        len: usize,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{ .data = self.data.ptr, .len = self.data.len };
+    }
+};
+
